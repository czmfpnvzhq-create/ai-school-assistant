# Copy to .env — never commit real values

# PostgreSQL connection string (Neon)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# JWT secret — must be at least 32 random characters, must match FRONTEND JWT_SECRET
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars

# Server port (Render / Railway will inject PORT automatically)
PORT=4000

# Frontend URL for CORS (set to your Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Hugging Face API key (backend may use this if AI is moved server-side)
HUGGINGFACE_API_KEY=hf_your_token_here
