# Copy to .env.local and fill in real values (no quotes around values)

# PostgreSQL connection (only needed if frontend runs Prisma directly)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Create at https://huggingface.co/settings/tokens
# Fine-grained: enable "Make calls to Inference Providers"
HUGGINGFACE_API_KEY=hf_your_token_here

# Must match the JWT_SECRET used in the backend exactly
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars

# Local development:  http://127.0.0.1:4000
# Production:         https://your-backend.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
